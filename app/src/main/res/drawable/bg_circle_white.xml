<?xml version="1.0" encoding="utf-8"?>
<!--
  圆形按钮底：自身声明 state_focused，系统便不会再叠加矩形焦点高亮，
  键盘/遥控器聚焦时只显示圆形灰色反馈（与返回按钮的水波纹形状一致）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/map_control_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/accent_outline" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?android:attr/colorControlHighlight" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/map_control_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_outline" />
        </shape>
    </item>
</selector>
