<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/surface_group" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_hairline" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/vehicle_card_surface" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_hairline" />
        </shape>
    </item>
</selector>
